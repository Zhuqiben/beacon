<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>goal_selector</name>
  <version>0.0.1</version>
  <description>GoToBlock action server and FSM</description>
  <maintainer email="Zhuqiben@users.noreply.github.com">Zhuqiben</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Zhuqiben/beacon</url>
  <url type="bugtracker">https://github.com/Zhuqiben/beacon/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>slam_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
