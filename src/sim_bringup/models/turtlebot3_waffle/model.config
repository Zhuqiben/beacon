<?xml version="1.0"?>
<model>
  <name>turtlebot3_waffle</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>

  <author>
    <name>ROBOTIS</name>
    <email>contact@robotis.com</email>
  </author>

  <description>
    TurtleBot3 Waffle with an RGB-D camera, 110 degree horizontal FOV (1.9199 rad).
    Self-owned OVERLAY of the upstream turtlebot3_gazebo model; it shadows the
    apt-installed turtlebot3_waffle via GAZEBO_MODEL_PATH priority so that the depth
    camera survives container rebuilds. Meshes are still loaded from
    model://turtlebot3_common/... See model.sdf for the full rationale.
  </description>
</model>
