<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_bringup</name>
  <version>0.0.1</version>
  <description>Simulation bringup: world, models, launch and Nav2 configuration</description>
  <maintainer email="Zhuqiben@users.noreply.github.com">Zhuqiben</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Zhuqiben/beacon</url>
  <url type="bugtracker">https://github.com/Zhuqiben/beacon/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>slam_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>landmark_detector</exec_depend>
  <exec_depend>ekf_slam</exec_depend>
  <exec_depend>landmark_map</exec_depend>
  <exec_depend>goal_selector</exec_depend>
  <exec_depend>visualizer</exec_depend>
  <exec_depend>performance_monitor</exec_depend>
  <exec_depend>client_node</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
